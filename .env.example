# Required
DISCORD_TOKEN=your_bot_token
CLIENT_ID=your_application_client_id

# Optional: put a guild ID here for instant command registration while testing.
# Leave empty to register commands globally.
GUILD_ID=

# Data / time
DB_PATH=./quests.sqlite
TIMEZONE=Africa/Casablanca

# Daily quest rotation
DAILY_QUEST_COUNT=5
MESSAGE_PROGRESS_COOLDOWN_SECONDS=8
VOICE_FLUSH_INTERVAL_SECONDS=60

# Optional channels
TICKET_CHANNEL_ID=
LOG_CHANNEL_ID=

# Mystery Box
# Comma-separated role IDs. The bot randomly selects one of these roles.
MYSTERY_BOX_ROLE_IDS=123456789012345678,234567890123456789

# Optional: same number of positive weights as MYSTERY_BOX_ROLE_IDS.
# Example 60,25,10 means the first role is much more common than the third.
MYSTERY_BOX_ROLE_WEIGHTS=60,25
